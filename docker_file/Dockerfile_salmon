# Adding a base image
FROM debian:13

# Adding some metadata to the image
LABEL image.description="A docker image for aligning prokaryotic RNA-seq data with bowtie2 and counting reads with Salmon"
LABEL image.author.name="Albert Palleja"
LABEL image.author.email="apca@dtu.dk"

# Setting the working directory
WORKDIR /app

# Installing required software from apt-get
# bowtie2: align reads to a reference
# samtools: deal with .bam files (sorting and indexing them)
# gffread: build the transcriptome fasta from the genome and the GTF
# salmon: count reads per transcript and per gene
RUN apt-get update && apt-get -y install \
    bowtie2 \
    gffread \
    salmon \
    samtools && \
    rm -rf /var/lib/apt/lists/*

# Copy the scripts folder to the image
COPY scripts/ ./scripts/
